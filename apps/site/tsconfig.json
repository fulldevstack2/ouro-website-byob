{
  "extends": "../../tsconfig.base.json",
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  // Nothing is excluded: every route is registered and type-checked. The two entries that used to
  // sit here went with /referral on 2026-09-15 (hooks/useWallet.ts was already off disk). If a file
  // ever needs excluding again, note that vite's `tsconfigPaths` reads this list too: an excluded
  // file loses the `~/*` alias and the production build fails to resolve its imports.
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
